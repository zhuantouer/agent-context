{
  "description": "agent-context lifecycle hooks for Codex",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-context.py\" codex",
            "statusMessage": "加载 Agentic 方法论",
            "additionalContextLimit": 10000
          }
        ]
      }
    ]
  }
}
